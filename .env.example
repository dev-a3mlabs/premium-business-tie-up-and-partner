PORT=5001

# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/premium-business-tieup-partner"

# Use a long random value (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET="replace-with-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
SESSION_MAX_HOURS=336

# Used only by `npm run db:seed` to create the first platform admin
PLATFORM_ADMIN_NAME="Nexora Admin"
PLATFORM_ADMIN_EMAIL="admin@example.com"
PLATFORM_ADMIN_PASSWORD="change-me-strong-password"
